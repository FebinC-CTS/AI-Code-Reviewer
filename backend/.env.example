# ─────────────────────────────────────────────
#  AI Code Review — Environment Configuration
# ─────────────────────────────────────────────
#  Copy this file to .env and fill in your key:
#    cp .env.example .env

# LLM Provider
LLM_PROVIDER=gemini

# Google Gemini API key
# Get one free at: https://aistudio.google.com/app/apikey
# Sign in with any Google account → click "Create API key" → paste below
GEMINI_API_KEY=AIzaSyC1tnmATcR1IMabqknR4Bsu8sgEypyvlpA

# Model — gemini-1.5-flash is fast and free-tier friendly
# Other option: gemini-1.5-pro  (smarter, still free tier, slower)
GEMINI_MODEL=gemini-1.5-pro

# ─────────────────────────────────────────────
#  Other settings
# ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
